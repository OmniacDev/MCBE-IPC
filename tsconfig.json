{
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2020",
    "lib": ["ES2021", "DOM"],
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "noImplicitAny": true,
    "strict": true,
    "pretty": true
  },
  "exclude": ["node_modules"],
  "include": ["src", "tests"]
}
